{
  "name": "@unintended/server-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:dev": "wrangler dev",
    "build": "pnpm --filter @unintended/shared build && pnpm --filter @unintended/world-data build && VITE_HOSTED=1 pnpm --filter @unintended/web build && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@unintended/game-core": "workspace:*",
    "@unintended/shared": "workspace:*",
    "@unintended/world-data": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  }
}
