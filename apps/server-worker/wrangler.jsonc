{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unintended-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOYMENT_ENV": "production"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "11ee3403e13f4c6ba410220e83e98b9d"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYER_STATE",
        "class_name": "PlayerState"
      },
      {
        "name": "REGION",
        "class_name": "Region"
      }
    ]
  },
  "exports": {
    "PlayerState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Region": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "local": {
      "name": "unintended-api-local",
      "vars": {
        "DEPLOYMENT_ENV": "local"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "11ee3403e13f4c6ba410220e83e98b9d"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    },
    "preview": {
      "name": "unintended-api-preview",
      "vars": {
        "DEPLOYMENT_ENV": "preview"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "11ee3403e13f4c6ba410220e83e98b9d"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    },
    "production": {
      "name": "unintended-api",
      "vars": {
        "DEPLOYMENT_ENV": "production"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "11ee3403e13f4c6ba410220e83e98b9d"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    }
  }
}
