{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unintended-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "vars": {
    "DEPLOYMENT_ENV": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYER_STATE",
        "class_name": "PlayerState"
      },
      {
        "name": "REGION",
        "class_name": "Region"
      }
    ]
  },
  "exports": {
    "PlayerState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Region": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "local": {
      "name": "unintended-api-local",
      "vars": {
        "DEPLOYMENT_ENV": "local"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    },
    "preview": {
      "name": "unintended-api-preview",
      "vars": {
        "DEPLOYMENT_ENV": "preview"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    },
    "production": {
      "name": "unintended-api",
      "vars": {
        "DEPLOYMENT_ENV": "production"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PLAYER_STATE",
            "class_name": "PlayerState"
          },
          {
            "name": "REGION",
            "class_name": "Region"
          }
        ]
      }
    }
  }
}
