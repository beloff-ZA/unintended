NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://unintended:unintended@localhost:5432/unintended
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
WORLD_SEED=78219472
DEV_AUTH=true

# Restricted AI reasoner. Enabled when a valid server-side OpenAI API key is present.
# The deterministic engine remains authoritative; AI handles bounded interpretation and response styling only.
AI_REASONER_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=4500
AI_PLAYER_RPM=4
AI_GLOBAL_RPM=240
